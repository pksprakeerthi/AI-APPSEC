# Copy to .env and fill in. Never commit .env.

# FalkorDB connection (local Docker defaults shown)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=appsec_investigator

# FalkorDB Cloud: use the host, port, username and password shown for your
# instance, and try FALKORDB_SSL=true if the plain connection is refused.

# Optional LLM narrative (the app works fully without it).
# Requires:  pip install anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Integration tests use a separate graph so your data is never touched.
FALKORDB_TEST_GRAPH=appsec_investigator_test
